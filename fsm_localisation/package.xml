<?xml version="1.0"?>
<package format="3">
  <name>fsm_localisation</name>
  <version>1.0.0</version>
  <description>Correspondenceless scan matching of panoramic 2D lidar scans in the frequency domain, in two modes: lidar odometry from consecutive scans, and correction of a pose estimate against an occupancy grid.</description>
  <maintainer email="alexandros.filotheou@gmail.com">Alexandros Filotheou</maintainer>
  <author email="alexandros.filotheou@gmail.com">Alexandros Filotheou</author>
  <license file="LICENSE">MIT</license>
  <license file="include/fsm_localisation/range_libc/LICENSE">Apache-2.0</license>

  <url type="repository">https://github.com/fourier-scan-matcher/fsm-localisation</url>
  <url type="bugtracker">https://github.com/fourier-scan-matcher/fsm-localisation/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>cgal</depend>
  <build_depend>libfftw3-dev</build_depend>
  <build_export_depend>libfftw3-dev</build_export_depend>
  <exec_depend>libfftw3</exec_depend>
  <buildtool_depend>pkg-config</buildtool_depend>
  <buildtool_export_depend>pkg-config</buildtool_export_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
